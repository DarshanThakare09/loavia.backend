# ─────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# The public URL of the deployed frontend (used for CORS and email links).
# No trailing slash.
FRONTEND_URL=https://yourdomain.com

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/loavia_prod"

# ─────────────────────────────────────────────
# AUTH — JWT SECRETS
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_64_CHARS

# ─────────────────────────────────────────────
# CACHE (Redis)
# ─────────────────────────────────────────────
REDIS_URL="redis://HOST:6379"

# ─────────────────────────────────────────────
# EMAIL (Resend — https://resend.com)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# ─────────────────────────────────────────────
# STORAGE (Cloudinary — https://cloudinary.com)
# ─────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─────────────────────────────────────────────
# PAYMENTS (Razorpay — https://razorpay.com)
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ─────────────────────────────────────────────
# PRODUCTION ADMIN (Initial Setup / Seed)
# Used during deployment by: npm run seed:admin:prod
# Or automatically on initial boot if provided
# ─────────────────────────────────────────────
# ADMIN_EMAIL=care@aksharfoods.com
# ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
