# ─────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# The public URL of the deployed frontend (used for CORS and email links).
# No trailing slash.
FRONTEND_URL=https://www.loavia.in

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/loavia_prod"

# ─────────────────────────────────────────────
# AUTH — JWT SECRETS
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_64_CHARS

# ─────────────────────────────────────────────
# CACHE (Redis / Render Valkey)
# ─────────────────────────────────────────────
REDIS_URL="redis://HOST:6379"

# ─────────────────────────────────────────────
# EMAIL (Resend — https://resend.com)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# ─────────────────────────────────────────────
# STORAGE (Cloudinary — https://cloudinary.com)
# ─────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─────────────────────────────────────────────
# PAYMENTS (Razorpay — https://razorpay.com)
# Set RAZORPAY_ENABLED=true to activate the payment gateway.
# When absent or set to anything other than "true", Razorpay is fully disabled
# and the server starts without requiring the three credential variables.
# The frontend does NOT currently integrate Razorpay — leave disabled for now.
# ─────────────────────────────────────────────
# RAZORPAY_ENABLED=true
# RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
# RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ─────────────────────────────────────────────
# PRODUCTION ADMIN (Initial Setup / Seed)
# Provide these on FIRST DEPLOYMENT ONLY to create the production admin account.
# After the admin is seeded, remove or unset them.
# Run: npm run seed:admin:prod
# Or they are consumed automatically on server boot if no admin exists in the DB.
# ─────────────────────────────────────────────
# ADMIN_EMAIL=care@aksharfoods.com
# ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
